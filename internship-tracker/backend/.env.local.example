# Copy to .env.local (gitignored). Overrides backend/.env for local development.
#
# 1. Replace YOUR_POSTGRES_PASSWORD with the password for the "postgres" user.
# 2. Create the database once (pgAdmin or psql):
#      CREATE DATABASE internship_tracker;
# 3. From backend/: npm start

DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/internship_tracker
JWT_SECRET=dev-secret-change-in-production
